<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- TOP BAR -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/back_icon"
                android:tint="#556270"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="56dp"
                android:text="New Chat"
                android:textColor="#556270"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/menuBtn"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/menu_icon"
                android:tint="#556270"/>

        </RelativeLayout>

        <!-- SEARCH -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/search_icon"
                android:tint="#9A9A9A"/>

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Search by name or username..."
                android:textColor="#222222"
                android:textColorHint="#9A9A9A"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- TOP CARDS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal">

            <!-- NEW GROUP -->

            <LinearLayout
                android:id="@+id/newGroupBtn"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/rounded_bg"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/add_friend_icon"
                        android:tint="#6D7886"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="New Group"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Up to 2,000 members"
                    android:textColor="#666666"
                    android:textSize="15sp"/>

            </LinearLayout>

            <Space
                android:layout_width="16dp"
                android:layout_height="wrap_content"/>

            <!-- SECRET CHAT -->

            <LinearLayout
                android:id="@+id/secretChatBtn"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_white"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/rounded_bg"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/security_icon"
                        android:tint="#6D7886"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Secret Chat"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="End-to-end encrypted"
                    android:textColor="#666666"
                    android:textSize="15sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- FREQUENT CONTACTS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="34dp"
            android:letterSpacing="0.08"
            android:text="FREQUENT CONTACTS"
            android:textAllCaps="true"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <!-- REAL FIREBASE USERS -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/frequentRecycler"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"/>

        <!-- A-Z CONTACTS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.08"
            android:text="A-Z CONTACTS"
            android:textAllCaps="true"
            android:textColor="#777777"
            android:textSize="14sp"/>

        <!-- FRIENDS LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/friendsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

</ScrollView>
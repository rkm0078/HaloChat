<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:background="#000000"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:weightSum="3">

    <!-- Chats -->

    <LinearLayout
        android:id="@+id/navChats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chatPill"
            android:layout_width="58dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_selected_nav"
            android:gravity="center">

            <ImageView
                android:id="@+id/chatIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/chat_icon"
                android:tint="#00D2FF"/>

        </LinearLayout>

        <TextView
            android:id="@+id/chatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="CHATS"
            android:textColor="#00D2FF"
            android:textSize="9sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Calls -->

    <LinearLayout
        android:id="@+id/navCalls"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/callPill"
            android:layout_width="58dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/callIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_call"
                android:tint="#666666"/>

        </LinearLayout>

        <TextView
            android:id="@+id/callText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="CALLS"
            android:textColor="#666666"
            android:textSize="9sp"/>

    </LinearLayout>

    <!-- Friends -->

    <LinearLayout
        android:id="@+id/navFriends"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/friendPill"
            android:layout_width="58dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/friendIcon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/check_icon"
                android:tint="#666666"/>

        </LinearLayout>

        <TextView
            android:id="@+id/friendText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="FRIENDS"
            android:textColor="#666666"
            android:textSize="9sp"/>

    </LinearLayout>

</LinearLayout>